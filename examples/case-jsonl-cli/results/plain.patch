+"""Command-line interface: main(argv=None) returns a process exit code.
+
+All input is validated before filtering or writing to stdout.
+"""
+import argparse
+import json
+import sys
+
+from .parser import InputError, parse
+from .stats import summarize
+
+
+def main(argv=None):
+    """Run stats or query over a file path (or '-' for standard input)."""
+    cli = argparse.ArgumentParser(prog="logtool")
+    commands = cli.add_subparsers(dest="command", required=True)
+    for name in ("stats", "query"):
+        command = commands.add_parser(name)
+        command.add_argument("path")
+        command.add_argument("--service")
+        if name == "query":
+            command.add_argument("--min-status", type=int)
+    args = cli.parse_args(argv)
+    try:
+        if args.path == "-":
+            rows = parse(getattr(sys.stdin, "buffer", sys.stdin))
+        else:
+            with open(args.path, "rb") as stream:
+                rows = parse(stream)
+        if args.service is not None:
+            rows = [row for row in rows if row["service"] == args.service]
+        if args.command == "stats":
+            output = json.dumps(summarize(rows)) + "\n"
+        else:
+            if args.min_status is not None:
+                rows = [row for row in rows if row["status"] >= args.min_status]
+            output = "".join(json.dumps(row) + "\n" for row in rows)
+    except (InputError, OSError, ValueError, RecursionError) as exc:
+        print(f"logtool: {exc}", file=sys.stderr)
+        return 2
+    sys.stdout.write(output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
