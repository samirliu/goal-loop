+"""Strict JSONL input: parse(stream) returns all validated original objects.
+
+Streams may yield UTF-8 bytes or text. Invalid input raises InputError with
+its physical (one-based) line number, before any records are returned.
+"""
+import json
+import math
+
+
+class InputError(ValueError):
+    """Invalid JSONL record or encoding."""
+
+
+def _constant(value):
+    raise ValueError(f"invalid JSON constant {value}")
+
+
 def parse(stream):
-    raise NotImplementedError("implement JSONL validation")
+    """Read and validate every record from a text or binary line iterable."""
+    rows = []
+    for number, line in enumerate(stream, 1):
+        try:
+            if isinstance(line, bytes):
+                line = line.decode("utf-8")
+            if not line.strip():
+                continue
+            row = json.loads(line, parse_constant=_constant)
+            if not isinstance(row, dict):
+                raise ValueError("record must be an object")
+            service = row.get("service")
+            if not isinstance(service, str) or not service:
+                raise ValueError("service must be a nonempty string")
+            status = row.get("status")
+            if type(status) is not int or not 100 <= status <= 599:
+                raise ValueError("status must be an integer from 100 to 599")
+            latency = row.get("latency_ms")
+            if (type(latency) not in (int, float) or latency < 0
+                    or (isinstance(latency, float) and not math.isfinite(latency))):
+                raise ValueError("latency_ms must be a finite nonnegative number")
+        except (ValueError, UnicodeError, RecursionError) as exc:
+            raise InputError(f"line {number}: {exc}") from exc
+        rows.append(row)
+    return rows
