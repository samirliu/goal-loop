+"""CLI interface: main(argv=None) parses arguments and returns an exit code.
+
+Input is validated in full before filtering or writing output. PATH '-' uses
+stdin; named files are opened as UTF-8. Input failures print stderr and return 2.
+"""
+import argparse
+import json
+import sys
+
+from .parser import ParseError, parse
+from .stats import summarize
+
+
+def main(argv=None):
+    """Run stats/query with optional service and inclusive status filtering."""
+    parser = argparse.ArgumentParser(prog='logtool')
+    commands = parser.add_subparsers(dest='command', required=True)
+    for command in ('stats', 'query'):
+        sub = commands.add_parser(command)
+        sub.add_argument('path')
+        sub.add_argument('--service')
+        if command == 'query':
+            sub.add_argument('--min-status', type=int)
+    args = parser.parse_args(argv)
+    try:
+        if args.path == '-':
+            rows = parse(sys.stdin)
+        else:
+            with open(args.path, encoding='utf-8') as stream:
+                rows = parse(stream)
+    except (OSError, UnicodeError, ParseError) as exc:
+        print(f'logtool: {exc}', file=sys.stderr)
+        return 2
+    if args.service is not None:
+        rows = [row for row in rows if row['service'] == args.service]
+    if args.command == 'stats':
+        print(json.dumps(summarize(rows)))
+    else:
+        if args.min_status is not None:
+            rows = [row for row in rows if row['status'] >= args.min_status]
+        output = ''.join(json.dumps(row) + '\n' for row in rows)
+        sys.stdout.write(output)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
