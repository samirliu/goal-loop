+"""JSONL validation. parse(stream) returns all validated original dictionaries.
+
+stream is an iterable of text lines. Invalid records raise ParseError with the
+physical line number. The eager result lets callers validate before emitting.
+"""
+import json
+import math
+
+
+class ParseError(ValueError):
+    """Invalid input, with its physical line number in the message."""
+
+
 def parse(stream):
-    raise NotImplementedError("implement JSONL validation")
+    """Read every nonblank line and return validated objects in input order."""
+    rows = []
+    for line_number, line in enumerate(stream, 1):
+        if not line.strip():
+            continue
+        try:
+            row = json.loads(line)
+        except (ValueError, RecursionError) as exc:
+            raise ParseError(f'line {line_number}: invalid JSON: {exc}') from exc
+        reason = None
+        if not isinstance(row, dict):
+            reason = 'record must be an object'
+        elif not isinstance(row.get('service'), str) or not row['service']:
+            reason = 'service must be a nonempty string'
+        elif type(row.get('status')) is not int or not 100 <= row['status'] <= 599:
+            reason = 'status must be an integer from 100 to 599'
+        else:
+            latency = row.get('latency_ms')
+            if type(latency) not in (int, float) or latency < 0:
+                reason = 'latency_ms must be a finite nonnegative number'
+            elif isinstance(latency, float) and not math.isfinite(latency):
+                reason = 'latency_ms must be a finite nonnegative number'
+        if reason:
+            raise ParseError(f'line {line_number}: {reason}')
+        rows.append(row)
+    return rows
