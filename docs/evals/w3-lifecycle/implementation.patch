new file mode 100644
index 0000000..983069f
--- /dev/null
+++ b/scripts/goal_runner.py
@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""Atomic unattended-run ownership and transactional budget observations.
+
+The permanent runner.lock inode provides kernel exclusion. .goal/lock is only
+a legacy-compatible human receipt. Budget files join the controller's immutable
+commit history; pointer publication precedes view installation, so interruption
+requires recovery instead of exposing a mixture as a valid run.
+"""
+import contextlib
+import fcntl
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import time
+import uuid
+
+spec = importlib.util.spec_from_file_location('goal_store', Path(__file__).with_name('goal_store.py'))
+store = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(store)
+
+
+def natural(value, label):
+    if not isinstance(value, str) or not value.isascii() or not value.isdigit():
+        raise store.StoreError('invalid-' + label)
+    return int(value)
+
+
+def boot_identity():
+    if sys.platform.startswith('linux'):
+        data = Path('/proc/sys/kernel/random/boot_id').read_bytes().strip()
+    elif sys.platform == 'darwin':
+        # Binary timeval, independent of locale/timezone and wall-clock edits.
+        data = subprocess.check_output(['/usr/sbin/sysctl', '-b', 'kern.boottime'], timeout=1)
+    else:
+        raise store.StoreError('persistent-monotonic-budget-unavailable')
+    if not data:
+        raise store.StoreError('boot-identity-unavailable')
+    return store._hash(data)
+
+
+def own(state, started, script, args):
+    natural(started, 'clock')
+    state = Path(state)
+    # Reuse the initialized store; do not create a second state hierarchy.
+    path = state / 'store/runner.lock'
+    fd = os.open(str(path), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            raise store.StoreError('invalid-runner-lock')
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise store.StoreError('live-lock; another runner owns this run') from exc
+        os.lseek(fd, 0, os.SEEK_SET)
+        previous_receipt = os.read(fd, 4096)
+        if previous_receipt:
+            previous_receipt = json.loads(previous_receipt)
+            if (not isinstance(previous_receipt, dict) or set(previous_receipt) != {'version', 'pid', 'started'}
+                    or type(previous_receipt['version']) is not int or previous_receipt['version'] != 1
+                    or type(previous_receipt['pid']) is not int or previous_receipt['pid'] <= 1
+                    or type(previous_receipt['started']) is not int or previous_receipt['started'] < 0):
+                raise store.StoreError('invalid-runner-lock-receipt')
+        receipt = store._close_path(state, 'lock')
+        if receipt.exists():
+            lines = receipt.read_text().splitlines()
+            if len(lines) != 2 or not all(v.isascii() and v.isdigit() for v in lines) or int(lines[0]) <= 1:
+                raise store.StoreError('invalid-legacy-runner-lock')
+            owned_receipt = previous_receipt and (previous_receipt['pid'], previous_receipt['started']) == tuple(map(int, lines))
+            if not owned_receipt:
+                try:
+                    os.kill(int(lines[0]), 0)
+                except ProcessLookupError:
+                    pass
+                else:
+                    raise store.StoreError('live-lock pid=' + lines[0])
+        os.lseek(fd, 0, os.SEEK_SET)
+        os.ftruncate(fd, 0)
+        os.write(fd, store._encode(dict(version=1, pid=os.getpid(), started=int(started))))
+        os.fsync(fd)
+        store._atomic(receipt, ('%s\n%s\n' % (os.getpid(), started)).encode('ascii'))
+        env = os.environ.copy()
+        env.update(GOAL_RUNNER_FD=str(fd), GOAL_RUNNER_EXEC_PID=str(os.getpid()),
+                   GOAL_RUNNER_OWNER_PID=str(os.getpid()), GOAL_RUNNER_STARTED_AT=started,
+                   GOAL_RUNNER_MONOTONIC_START=str(time.monotonic()))
+        env.pop('GOAL_RUNNER_MONOTONIC_END', None)
+        os.set_inheritable(fd, True)
+        os.execvpe('bash', ['bash', script, *args], env)
+    finally:
+        os.close(fd)
+
+
+@contextlib.contextmanager
+def ledger(state):
+    fd = os.open(str(state), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise store.StoreError('ledger-busy; budget observation refused') from exc
+        if (state / 'store/pending').exists():
+            raise store.StoreError('recovery-required')
+        store.verify_views(state)
+        yield
+    finally:
+        os.close(fd)
+
+
+def runner_data(data):
+    value = json.loads(data)
+    if (not isinstance(value, dict) or set(value) != {'version', 'run', 'scope', 'started', 'deadline', 'clock', 'monotonic', 'result'}
+            or type(value['version']) is not int or value['version'] != 1
+            or not isinstance(value['run'], str) or not store._OPERATION.fullmatch(value['run'])
+            or value['scope'] != 'script-entry'
+            or any(type(value[n]) is not int or value[n] < 0 for n in ('started', 'deadline', 'clock'))):
+        raise store.StoreError('invalid-runner-state')
+    mono = value['monotonic']
+    if (not isinstance(mono, dict) or set(mono) != {'boot', 'deadline'}
+            or not isinstance(mono['boot'], str) or not store._SHA256.fullmatch(mono['boot'])
+            or type(mono['deadline']) not in (int, float) or not math.isfinite(mono['deadline']) or mono['deadline'] < 0):
+        raise store.StoreError('invalid-persisted-monotonic-budget')
+    result = value['result']
+    if result is not None and (not isinstance(result, dict) or set(result) != {'outcome', 'gate_completed', 'elapsed', 'timely'}
+            or result['outcome'] not in ('delivered', 'incomplete') or type(result['gate_completed']) is not int
+            or result['gate_completed'] < 0 or type(result['elapsed']) not in (int, float)
+            or not math.isfinite(result['elapsed']) or result['elapsed'] < 0 or type(result['timely']) is not bool):
+        raise store.StoreError('invalid-runner-result')
+    return value
+
+
+def budget(state, action, started, wallclock, now):
+    state = Path(state)
+    started = natural(started, 'clock')
+    wallclock = natural(wallclock, 'wallclock')
+    now = natural(now, 'clock')
+    mono_start = float(os.environ['GOAL_RUNNER_MONOTONIC_START'])
+    mono_now = time.monotonic()
+    boot = boot_identity()
+    if not math.isfinite(mono_start) or mono_start > mono_now:
+        raise store.StoreError('invalid-monotonic-origin')
+    with ledger(state):
+        commits = store.Store(state / 'store/commits')
+        head, snapshot = commits.read()
+        meta = json.loads(snapshot[store._VIEW_META])
+        previous = runner_data(snapshot['runner.json']) if 'runner.json' in snapshot else None
+        high = started
+        deadlines = [started + wallclock]
+        if previous:
+            high = max(high, previous['clock'])
+            deadlines.append(previous['deadline'])
+        # Import legacy sidecars once, without forgiving corruption or rollback.
+        for name in ('runner.clock', 'runner.deadline'):
+            path = store._close_path(state, name)
+            if path.exists():
+                value = natural(path.read_text().strip(), name.replace('.', '-'))
+                if name.endswith('clock'):
+                    high = max(high, value)
+                else:
+                    deadlines.append(value)
+        if now < high or started < (previous['clock'] if previous else 0) and action == 'begin':
+            raise store.StoreError('clock-regressed')
+        rows = [line[9:] for line in snapshot['state.rec'].decode('ascii').splitlines() if line.startswith('deadline=')]
+        if len(rows) != 1:
+            raise store.StoreError('invalid-contract-deadline')
+        contract = natural(rows[0], 'contract-deadline')
+        if contract:
+            deadlines.append(contract)
+        deadline = min(deadlines)
+        mono_end = min(mono_start + wallclock, mono_now + max(0, deadline - now))
+        if previous:
+            if previous['monotonic']['boot'] == boot:
+                mono_end = min(mono_end, previous['monotonic']['deadline'])
+            elif now <= previous['clock']:
+                raise store.StoreError('clock-regressed-across-reboot')
+        if os.environ.get('GOAL_RUNNER_MONOTONIC_END'):
+            mono_end = min(mono_end, float(os.environ['GOAL_RUNNER_MONOTONIC_END']))
+        if not math.isfinite(mono_end):
+            raise store.StoreError('invalid-monotonic-deadline')
+        value = previous or dict(version=1, run=uuid.uuid4().hex, scope='script-entry',
+                                 started=started, deadline=deadline, clock=now, result=None)
+        value.update(deadline=deadline, clock=now, monotonic=dict(boot=boot, deadline=mono_end))
+        if action == 'begin':
+            value['result'] = None
+        if action in ('delivered', 'incomplete'):
+            value['result'] = dict(outcome=action, gate_completed=now,
+                                   elapsed=mono_now-mono_start,
+                                   timely=action == 'delivered' and now < deadline and mono_now < mono_end)
+        elif action not in ('begin', 'observe'):
+            raise store.StoreError('unknown-budget-action')
+        files = {'runner.json': store._encode(value), 'runner.clock': ('%s\n' % now).encode('ascii'),
+                 'runner.deadline': ('%s\n' % deadline).encode('ascii')}
+        # Prepare a complete snapshot without first changing live files.
+        if any(snapshot.get(name) != data for name, data in files.items()):
+            updated = dict(snapshot)
+            # Operation-specific retry receipts do not belong to this commit.
+            updated.pop(store._CLOSE_META, None)
+            updated.pop(store._MUTATION_META, None)
+            updated.update(files)
+            meta['views'].update({name: store._hash(data) for name, data in files.items()})
+            updated[store._VIEW_META] = store._encode(meta)
+            def fault(stage):
+                if os.environ.get('GOAL_RUNNER_FAULT') == stage:
+                    os._exit(91)
+            commits.commit('runner-' + uuid.uuid4().hex, store._encode({'action': action, 'clock': now}), updated,
+                           expected_head=head, fault=fault)
+            # A crash here leaves a mismatched projection, never valid old time.
+            store._restore_views(state, files)
+        remaining = max(0, math.ceil(min(deadline-now, mono_end-time.monotonic())))
+        print('%s %s %s %.9f' % (deadline, now, remaining, mono_end))
+        if action in ('delivered', 'incomplete'):
+            print('GOAL_LOOP: RESULT outcome=%s timing=%s scope=script-entry' %
+                  (action, 'within-budget' if value['result']['timely'] else 'after-deadline' if action == 'delivered' else 'incomplete'),
+                  file=sys.stderr)
+
+
+if __name__ == '__main__':
+    try:
+        if len(sys.argv) >= 6 and sys.argv[1] == 'own':
+            own(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
+        elif len(sys.argv) == 7 and sys.argv[1] == 'budget':
+            budget(*sys.argv[2:])
+        else:
+            raise store.StoreError('invalid-runner-command')
+    except (store.StoreError, OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as exc:
+        print('GOAL_LOOP: ERROR %s' % exc, file=sys.stderr)
+        sys.exit(4)
diff --git a/tests/test_runner_lifecycle.py b/tests/test_runner_lifecycle.py
new file mode 100644
index 0000000..2f27264
--- /dev/null
+++ b/tests/test_runner_lifecycle.py
@@ -0,0 +1,227 @@
+"""Production entrypoints: concurrent ownership, budget commits and cancellation."""
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import tempfile
+import time
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+CTL = ROOT / 'scripts/goal_ctl.sh'
+LOOP = ROOT / 'scripts/goal_loop.sh'
+GATE = ROOT / 'scripts/goal_gate.sh'
+
+
+class Lifecycle(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='goal-lifecycle-')
+        self.addCleanup(self.temp.cleanup)
+        self.project = Path(self.temp.name)
+        self.state = self.project / '.goal'
+        self.call(CTL, 'init')
+
+    def call(self, script, *args, env=None, timeout=15):
+        return subprocess.run(['bash', str(script), *args, '--project', str(self.project)],
+                              capture_output=True, env=env, timeout=timeout)
+
+    def contract(self, command='true', knobs=''):
+        (self.state / 'goal.md').write_text(
+            '# Goal\n\n## Acceptance criteria\n\n'
+            '- AC-1 | output | check: `' + command + '` | expected: exit=0\n\n'
+            '## Budgets\n\n' + knobs + '\n\n## Approval\n\napproved: PENDING\n')
+        result = self.call(CTL, 'stamp', '--auto')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def mock(self, source):
+        path = self.project / 'executor'
+        path.write_text('#!/bin/bash\n' + source)
+        path.chmod(0o755)
+        return dict(os.environ, CLAUDE_BIN=str(path))
+
+    def start(self, script, *args, env=None):
+        process = subprocess.Popen(['bash', str(script), *args, '--project', str(self.project)],
+                                   env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        def cleanup():
+            if process.poll() is None:
+                process.kill()
+            process.communicate(timeout=6)
+        self.addCleanup(cleanup)
+        return process
+
+    def wait_file(self, name, process):
+        until = time.monotonic() + 6
+        path = self.state / name
+        while not path.exists():
+            if process.poll() is not None:
+                out, err = process.communicate()
+                self.fail('process exited before ready: %r' % (out + err))
+            self.assertLess(time.monotonic(), until, 'no readiness marker')
+            time.sleep(0.01)
+        return path
+
+    def test_competing_runners_dispatch_exactly_one_worker(self):
+        self.contract()
+        env = self.mock('echo call >> .goal/calls\ntouch .goal/ready\nsleep 2\n')
+        jobs = [self.start(LOOP, '--continue', '--wallclock=8', '--max-iterations=1', env=env) for _ in range(6)]
+        results = []
+        for job in jobs:
+            out, err = job.communicate(timeout=12)
+            results.append((job.returncode, out + err))
+        self.assertEqual((self.state / 'calls').read_text().count('call'), 1, results)
+        self.assertEqual(sum(rc == 3 for rc, _ in results), 1, results)
+        self.assertEqual(sum(rc == 4 and b'live-lock' in out for rc, out in results), 5, results)
+        self.assertFalse((self.state / 'lock').exists())
+
+    def test_runner_death_before_reaping_stops_group_and_releases_ownership(self):
+        if not hasattr(os, 'waitid') or not hasattr(os, 'WNOWAIT'):
+            self.skipTest('requires waitid WNOWAIT')
+        self.contract()
+        env = self.mock('(sleep 1.5; echo leaked > .goal/leak) &\ntouch .goal/ready\nwait\n')
+        owner = self.start(LOOP, '--continue', '--wallclock=10', env=env)
+        self.wait_file('ready', owner)
+        owner.kill()
+        status = os.waitid(os.P_PID, owner.pid, os.WEXITED | os.WNOWAIT)
+        self.assertEqual(status.si_status, signal.SIGKILL)
+        time.sleep(1.8)
+        os.kill(owner.pid, 0)  # Still an unreaped zombie, not a dead PID probe.
+        self.assertFalse((self.state / 'leak').exists())
+        retry = self.call(LOOP, '--continue', '--resume', '--dry-run', '--wallclock=10', '--max-iterations=1')
+        self.assertEqual(retry.returncode, 3, retry.stdout + retry.stderr)
+        self.assertEqual(os.waitid(os.P_PID, owner.pid, os.WEXITED | os.WNOWAIT).si_pid, owner.pid)
+        self.assertEqual(owner.wait(timeout=3), -signal.SIGKILL)
+
+    def test_budget_commit_failure_sides_and_exact_recovery(self):
+        self.contract()
+        before = (self.state / 'store/commits/current').read_bytes()
+        env = dict(os.environ, GOAL_RUNNER_FAULT='generation-published')
+        failed = self.call(LOOP, '--continue', '--dry-run', '--wallclock=20', '--max-iterations=1', env=env)
+        self.assertNotEqual(failed.returncode, 0)
+        self.assertEqual((self.state / 'store/commits/current').read_bytes(), before)
+        self.assertFalse((self.state / 'runner.deadline').exists())
+        self.assertEqual(self.call(CTL, 'status').returncode, 0)
+
+        env['GOAL_RUNNER_FAULT'] = 'pointer-published'
+        failed = self.call(LOOP, '--continue', '--dry-run', '--wallclock=20', '--max-iterations=1', env=env)
+        self.assertNotEqual(failed.returncode, 0)
+        self.assertNotEqual((self.state / 'store/commits/current').read_bytes(), before)
+        rejected = self.call(GATE, '--verify')
+        self.assertEqual(rejected.returncode, 4, rejected.stdout + rejected.stderr)
+        self.assertIn(b'ledger-view-mismatch', rejected.stderr)
+        result = self.call(CTL, 'recover')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        value = json.loads((self.state / 'runner.json').read_bytes())
+        deadline = (self.state / 'runner.deadline').read_bytes()
+        self.assertEqual(int(deadline), value['deadline'])
+        self.assertEqual(int((self.state / 'runner.clock').read_bytes()), value['clock'])
+        self.assertEqual(self.call(GATE, '--verify').returncode, 0)
+        retry = self.call(LOOP, '--continue', '--resume', '--dry-run', '--wallclock=200', '--max-iterations=1')
+        self.assertEqual(retry.returncode, 3, retry.stdout + retry.stderr)
+        self.assertEqual((self.state / 'runner.deadline').read_bytes(), deadline)
+
+    def test_runner_views_cannot_extend_budget_outside_commit(self):
+        self.contract()
+        result = self.call(LOOP, '--continue', '--dry-run', '--wallclock=10', '--max-iterations=1')
+        self.assertEqual(result.returncode, 3, result.stdout + result.stderr)
+        originals = {name: (self.state / name).read_bytes() for name in ('runner.clock', 'runner.deadline', 'runner.json')}
+        for name, data in originals.items():
+            with self.subTest(name=name):
+                (self.state / name).write_bytes(data + b' ')
+                result = self.call(CTL, 'status')
+                self.assertEqual(result.returncode, 4, result.stdout + result.stderr)
+                self.assertIn(b'ledger-view-mismatch', result.stderr)
+                self.assertEqual(self.call(CTL, 'recover').returncode, 0)
+                self.assertEqual((self.state / name).read_bytes(), data)
+
+    def test_late_product_go_is_not_counted_as_timely_success(self):
+        self.contract()
+        env = self.mock('echo unexpected > .goal/worker-started\n')
+        (self.project / 'artifact.txt').write_text('delivered\n')
+        closed = self.call(CTL, 'close-iteration', '--task', 'T1', '--files', 'artifact.txt',
+                           '--checks-pass', '1', '--checks-fail', '0', '--checks-unverifiable', '0',
+                           '--progress', 'yes', '--exit-signal', 'yes', '--adversarial', 'clear',
+                           '--adversarial-note', 'reviewed', '--no-gate')
+        self.assertEqual(closed.returncode, 0, closed.stdout + closed.stderr)
+        (self.state / 'runner.deadline').write_text('1\n')  # legacy expired run, imported once
+        result = self.call(LOOP, '--continue', '--wallclock=20', '--max-iterations=1', env=env)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn(b'GATE: GO', result.stdout + result.stderr)
+        self.assertIn(b'timing=after-deadline', result.stdout + result.stderr)
+        self.assertFalse((self.state / 'worker-started').exists())
+        receipt = json.loads((self.state / 'runner.json').read_bytes())['result']
+        self.assertEqual(receipt['outcome'], 'delivered')
+        self.assertFalse(receipt['timely'])
+
+    def test_frozen_wall_clock_cannot_renew_monotonic_budget(self):
+        self.contract()
+        env = self.mock('echo call >> .goal/calls\nsleep 3\n')
+        bindir = self.project / 'bin'
+        bindir.mkdir()
+        date = bindir / 'date'
+        date.write_text('#!/bin/bash\nif [ "$1" = +%s ]; then echo ' + str(int(time.time())) + '; else /bin/date "$@"; fi\n')
+        date.chmod(0o755)
+        env['PATH'] = str(bindir) + os.pathsep + env['PATH']
+        start = time.monotonic()
+        result = self.call(LOOP, '--continue', '--wallclock=2', '--max-iterations=3', env=env)
+        self.assertEqual(result.returncode, 3, result.stdout + result.stderr)
+        # Two seconds search + at most three seconds final settlement + setup.
+        self.assertLess(time.monotonic() - start, 6)
+        self.assertEqual((self.state / 'calls').read_text().count('call'), 1)
+        retry = self.call(LOOP, '--continue', '--resume', '--wallclock=200', '--max-iterations=1', env=env)
+        self.assertEqual(retry.returncode, 3, retry.stdout + retry.stderr)
+        self.assertEqual((self.state / 'calls').read_text().count('call'), 1, 'resume renewed frozen-clock budget')
